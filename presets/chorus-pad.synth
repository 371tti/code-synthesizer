# CHORUS PAD — true stereo ChorusとGlobal reverbを持つPad
p.gain = param(0.42, 0, 1.5, 0.01)
p.attack_s = param(1.1, 0.02, 8, 0.01)
p.decay_s = param(2.5, 0.1, 10, 0.01)
p.sustain = param(0.82, 0, 1, 0.01)
p.release_s = param(5, 0.2, 16, 0.1)
p.detune_cent = param(8, 0, 35, 0.1)
p.chorus_hz = param(0.24, 0.03, 4, 0.01)
p.depth_ms = param(9, 0, 25, 0.1)
p.width = param(1.22, 0, 1.6, 0.01)
p.brightness = param(0.48, 0, 1, 0.01, 74)
p.reverb_mix = param(0.22, 0, 0.8, 0.01)

fn note(in, p) -> out {
    attack = min(in.t / p.attack_s, 1)
    decay = p.sustain + (1 - p.sustain) * exp(-4 * in.t / p.decay_s)
    release = exp(-7 * in.l / p.release_s)
    ratio = cent_ratio(p.detune_cent)
    raw_l = triangle(in.freq / ratio, in.t) + p.brightness * saw(in.freq, in.t) * 0.45
    raw_r = triangle(in.freq * ratio, in.t) + p.brightness * saw(in.freq, in.t) * 0.45
    left = chorus(raw_l, p.chorus_hz, p.depth_ms * 1ms, 18ms)
    right = chorus(raw_r, p.chorus_hz * 1.07, p.depth_ms * 1ms, 23ms)
    amp = p.gain * in.s * in.vol * in.mexpr * attack * decay * release
    out.wave_l = amp * left * pan_l(in.midi_pan)
    out.wave_r = amp * right * pan_r(in.midi_pan)
    out.l_limit = p.release_s
}

fn filter(in, p) -> out {
    wet_l = reverb.schroeder(in.wave_l, 0.58, 0.72, 0.38)
    wet_r = reverb.schroeder(in.wave_r, 0.64, 0.72, 0.38)
    wide = stereo.width(mix(in.wave_l, wet_l, p.reverb_mix),
        mix(in.wave_r, wet_r, p.reverb_mix), p.width)
    out.wave_l = wide.left
    out.wave_r = wide.right
}
