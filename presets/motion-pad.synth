# Motion Pad — ホストのtempo/beatとMIDI表現に反応します。
p.attack_s = param(0.8, 0.03, 6, 0.01)
p.release_s = param(4.5, 0.3, 14, 0.01)
p.motion = param(0.35, 0, 1, 0.01)
p.spread = param(0.4, 0, 1, 0.01)
fn note(in, p) -> out {
    attack = min(in.t / p.attack_s, 1)
    release = exp(-7 * in.l / p.release_s)
    motion = p.motion * (0.25 + 0.75 * in.mw)
        * sin(TAU * in.beat / 4 + in.voice * 0.7)
    air = 0.06 + 0.24 * in.cc(74)
    left_osc = sin(TAU * in.freq * 0.997 * in.t + motion)
    right_osc = sin(TAU * in.freq * 1.003 * in.t - motion)
    air_osc = air * sin(TAU * in.freq * 2 * in.t + motion * 1.7)
    out.wave = 0.42 * in.s * in.vol * in.mexpr * attack * release
        * (left_osc + right_osc + air_osc)
    out.pan = in.midi_pan + p.spread * sin(in.voice * 1.9)
    out.l_limit = p.release_s
}
