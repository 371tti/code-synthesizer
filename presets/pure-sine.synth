p.attack_ms = param(8.33, 1, 200, 0.1)
p.release_s = param(1.5, 0.1, 6, 0.01)
p.gain = param(1, 0, 1.5, 0.01)

fn note(in, p) -> out {
    attack = min(in.t * 1000 / p.attack_ms, 1)
    # Release Sを大きくすると余韻が長くなります。
    release = exp(-9 * in.l / p.release_s)
    env = attack * release
    out.wave = p.gain * env * in.s * in.vol * in.mexpr * sin(TAU * in.freq * in.t)
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}
