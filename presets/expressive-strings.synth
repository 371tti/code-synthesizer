# Expressive Strings — エクスプレッションはエンジンが適用します。MWでビブラート、
# チャンネルプレッシャーで弓の強さ、CC74で高次倍音を加えます。
p_attack_s = param(0.18, 0.01, 3, 0.01)
p_release_s = param(2.8, 0.2, 10, 0.01)
p_bow = param(0.55, 0, 1, 0.01)
p_spread = param(0.28, 0, 1, 0.01)

attack = min(t / p_attack_s, 1)
release = exp(-7 * l / p_release_s)
vibrato = mw * 0.008 * sin(TAU * 5.2 * t + voice)
phase = TAU * freq * t + vibrato
bow = p_bow * (0.7 + 0.3 * pressure)
brightness = 0.12 + 0.35 * cc(74)
string = sin(phase) + bow * 0.32 * sin(phase * 2) + brightness * sin(phase * 3)
wave = 0.58 * s * attack * release * tanh(1.35 * string)
pan = midi_pan + p_spread * sin(voice * 2.1)
l_limit = p_release_s
