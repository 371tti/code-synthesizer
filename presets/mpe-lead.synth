# MPE Lead — MWとpoly pressureにノート単位で反応します。
p.gain = param(0.65, 0, 1.5, 0.01)
p.bite = param(0.45, 0, 1, 0.01)
p.vibrato_hz = param(5.5, 0.1, 12, 0.1)
p.release_s = param(0.45, 0.05, 4, 0.01)
note.out.layout = mono

fn note(in, p) -> out {
    attack = min(in.t / 0.008, 1)
    release = exp(-8 * in.l / p.release_s)
    vibrato = in.mw * 0.012 * sin(TAU * p.vibrato_hz * in.t)
    phase = TAU * in.freq * in.t + vibrato
    bite = p.bite * (0.35 + 0.65 * in.poly_pressure)
    core = sin(phase) + bite * sin(phase * 2) + 0.16 * bite * sin(phase * 3)
    out.wave = p.gain * in.s * in.vol * in.mexpr * attack * release * tanh(1.45 * core)
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}
