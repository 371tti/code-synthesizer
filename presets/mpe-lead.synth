# MPE Lead — ピッチベンドはfreqに適用済みです。MWでビブラート、
# poly_pressureでノートごとの鋭さを加えます。
p_gain = param(0.65, 0, 1.5, 0.01)
p_bite = param(0.45, 0, 1, 0.01)
p_vibrato_hz = param(5.5, 0, 12, 0.1)
p_release_s = param(0.45, 0.05, 4, 0.01)

attack = min(t / 0.008, 1)
release = exp(-8 * l / p_release_s)
vibrato = mw * 0.012 * sin(TAU * p_vibrato_hz * t)
phase = TAU * freq * t + vibrato
bite = p_bite * (0.35 + 0.65 * poly_pressure)
core = sin(phase) + bite * sin(phase * 2) + 0.16 * bite * sin(phase * 3)
wave = p_gain * s * attack * release * tanh(1.45 * core)
pan = midi_pan
l_limit = p_release_s
