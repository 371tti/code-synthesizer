# METAL DRUM — 変調modal bankで作るMetallic Percussion
p.gain = param(0.76, 0, 1.5, 0.01)
p.decay_s = param(0.9, 0.03, 6, 0.01)
p.release_s = param(0.5, 0.01, 4, 0.01)
p.metal = param(0.82, 0, 1, 0.01, 74)
p.drive = param(1.3, 0.5, 6, 0.01)
p.pan = param(0, -1, 1, 0.01)

fn note(in, p) -> out {
    hit = exciter.noise(in.t, 4ms)
    a = modal(hit, in.freq * 1.0, p.decay_s, 1)
    b = modal(hit, in.freq * 2.71, p.decay_s * 0.68, 0.72)
    c = modal(hit, in.freq * 4.09, p.decay_s * 0.42, 0.5)
    d = modal(hit, in.freq * 5.43, p.decay_s * 0.3, 0.34)
    release = exp(-9 * in.l / p.release_s)
    tone = drive(a + p.metal * (b + c + d), p.drive)
    out.wave = p.gain * in.s * in.vol * in.mexpr * release * tone
    out.pan = clamp(in.midi_pan + p.pan, -1, 1)
    out.l_limit = p.release_s
}
