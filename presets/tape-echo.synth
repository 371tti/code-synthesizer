# TAPE ECHO — Saturated synthとmultitap tape echo
p.gain = param(0.5, 0, 1.5, 0.01)
p.attack_s = param(0.025, 0.001, 2, 0.001)
p.release_s = param(1.6, 0.05, 10, 0.01)
p.tone_hz = param(3200, 100, 14000, 1, 74)
p.echo_mix = param(0.36, 0, 0.9, 0.01)
p.feedback = param(0.52, 0, 0.92, 0.01)
p.wow = param(0.25, 0, 1, 0.01)

fn note(in, p) -> out {
    attack = min(in.t / p.attack_s, 1)
    release = exp(-7 * in.l / p.release_s)
    raw = saw(in.freq, in.t) + 0.18 * sin(TAU * in.freq * 0.5 * in.t)
    tone = filter.onepole.lp(saturate(raw, 1.8), p.tone_hz, in.sr)
    out.wave = p.gain * in.s * in.vol * in.mexpr * attack * release * tone
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}

fn filter(in, p) -> out {
    # filterではtransportのppqを使えるため、wowもDAW transportへ同期します。
    mod_l = 280ms + p.wow * 16ms * sin(TAU * 0.17 * in.ppq)
    mod_r = 420ms + p.wow * 19ms * sin(TAU * 0.13 * in.ppq + 1.3)
    echo_l = delay.feedback(in.wave_l, mod_l, p.feedback)
    echo_r = delay.feedback(in.wave_r, mod_r, p.feedback)
    taps_l = delay.multitap(in.wave_l, 95ms, 190ms, 380ms)
    taps_r = delay.multitap(in.wave_r, 142ms, 285ms, 570ms)
    out.wave_l = mix(in.wave_l, echo_l + 0.2 * (taps_l.tap1 + taps_l.tap2 + taps_l.tap3), p.echo_mix)
    out.wave_r = mix(in.wave_r, echo_r + 0.2 * (taps_r.tap1 + taps_r.tap2 + taps_r.tap3), p.echo_mix)
}
