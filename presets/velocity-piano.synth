p.gain = param(0.8, 0, 1.4, 0.01)
p.brightness = param(0.7, 0, 1, 0.01)
p.release_s = param(2.2, 0.2, 8, 0.01)
p.hammer = param(0.55, 0, 1, 0.01)
note.out.layout = mono

fn note(in, p) -> out {
    attack = min(in.t / 0.004, 1)
    release = exp(-9 * in.l / p.release_s)
    velocity_brightness = p.brightness * (0.25 + 0.75 * in.s)
    hammer = exp(-38 * in.t) * (p.hammer + velocity_brightness)
    fundamental = sin(TAU * in.freq * in.t)
    partial_2 = 0.28 * velocity_brightness * sin(TAU * in.freq * 2.01 * in.t)
    partial_3 = 0.11 * velocity_brightness * sin(TAU * in.freq * 3.99 * in.t)
    body = 0.85 + 0.15 * in.pressure
    out.wave = p.gain * in.s * in.vol * in.mexpr * attack * release * body
        * tanh(1.25 * (fundamental + partial_2 + partial_3 + hammer))
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}
