# SYNTH BRASS — Punchのあるenvelopeとstate filterを持つPoly Brass
p.gain = param(0.58, 0, 1.5, 0.01)
p.attack_s = param(0.055, 0.002, 1.5, 0.001)
p.decay_s = param(0.48, 0.03, 4, 0.01)
p.sustain = param(0.7, 0, 1, 0.01)
p.release_s = param(0.72, 0.03, 6, 0.01)
p.cutoff_hz = param(1450, 80, 12000, 1, 74)
p.filter_punch = param(2.4, 0, 5, 0.01)
p.filter_decay_s = param(0.3, 0.02, 3, 0.01)
p.saw_mix = param(0.72, 0, 1, 0.01)
p.pulse_width = param(0.46, 0.08, 0.92, 0.01)
p.detune_cent = param(4.5, 0, 30, 0.1)
p.drive = param(1.35, 0.5, 6, 0.01)
p.vibrato_hz = param(5.1, 0.1, 12, 0.1)
p.vibrato_cent = param(7, 0, 60, 0.1)

fn note(in, p) -> out {
    f32 voice lowpass = 0
    attack = min(in.t / p.attack_s, 1)
    decay = p.sustain + (1 - p.sustain) * exp(-5 * in.t / p.decay_s)
    release = exp(-8 * in.l / p.release_s)
    vibrato = p.vibrato_cent * (in.mw + 0.35 * in.pressure)
        * sin(TAU * p.vibrato_hz * in.t)
    freq = in.freq * cent_ratio(vibrato)
    detune = cent_ratio(p.detune_cent)
    saw_pair = 0.5 * (saw(freq / detune, in.t) + saw(freq * detune, in.t))
    pulse_layer = pulse(freq, in.t, p.pulse_width)
    source = mix(pulse_layer, saw_pair, p.saw_mix)

    filter_env = exp(-6 * in.t / p.filter_decay_s)
    cutoff = clamp(p.cutoff_hz * pow(2, p.filter_punch * filter_env), 30, in.sr * 0.45)
    alpha = 1 - exp(-TAU * cutoff / in.sr)
    lowpass = lowpass + alpha * (tanh(p.drive * source) - lowpass)

    out.wave = p.gain * in.s * in.vol * in.mexpr * attack * decay * release
        * lowpass
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}
