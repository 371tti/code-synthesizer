# LO-FI KEYS — bitcrush、downsample、tremoloを持つKeys
p.gain = param(0.62, 0, 1.5, 0.01)
p.decay_s = param(1.4, 0.05, 8, 0.01)
p.release_s = param(0.85, 0.02, 6, 0.01)
p.bits = param(7, 2, 16, 1)
p.downsample = param(5, 1, 24, 1)
p.tone_hz = param(4200, 200, 14000, 1, 74)
p.wobble_hz = param(3.8, 0.1, 12, 0.1)
p.wobble_depth = param(0.15, 0, 1, 0.01)

fn note(in, p) -> out {
    env = exp(-5 * in.t / p.decay_s) * exp(-8 * in.l / p.release_s)
    raw = 0.7 * triangle(in.freq, in.t) + 0.25 * pulse(in.freq * 2, in.t, 0.32)
    crushed = bitcrush(raw, p.bits)
    held = downsample(crushed, p.downsample)
    tone = tremolo(filter.onepole.lp(held, p.tone_hz, in.sr), p.wobble_hz, p.wobble_depth)
    out.wave = p.gain * in.s * in.vol * in.mexpr * env * tone
    out.pan = in.midi_pan
    out.l_limit = p.release_s
}
